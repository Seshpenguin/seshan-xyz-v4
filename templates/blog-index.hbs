{{#*inline "page"}}
<!-- Blog Widget -->
<div id="blog-widget">
  <h3>Blog</h3>
  <a href="https://blog.seshan.xyz" class="view-all-link">View All Posts →</a>
  <div id="blog-posts">
	<blockquote>
	  <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><style>.spinner_S1WN{animation:spinner_MGfb .8s linear infinite;animation-delay:-.8s}.spinner_Km9P{animation-delay:-.65s}.spinner_JApP{animation-delay:-.5s}@keyframes spinner_MGfb{93.75%,100%{opacity:.2}}</style><circle class="spinner_S1WN" cx="4" cy="12" r="3"/><circle class="spinner_S1WN spinner_Km9P" cx="12" cy="12" r="3"/><circle class="spinner_S1WN spinner_JApP" cx="20" cy="12" r="3"/></svg>
	</blockquote>
  </div>
  <div id="blog-post-count"></div>
  <br />
  <hr />
</div>
<script src="/public/js/blog-widget.js"></script> 
<!-- End Blog Widget -->

<h3 id="archive">Archive - Old Blog Posts</h3>
<ul>
	<blockquote>Note! This blog is no longer active, and the posts are outdated by now. Many of them no longer reflect my current thoughts.</blockquote>
	<blockquote>These posts were created on various different versions of my website, therefore, much of the content (such as images) and layout may be broken. The remain here for historical preservation purposes!</blockquote>
	{{#each posts}}
	  <li>
		<a href="{{path}}">{{name}}</a>
	  </li>
	{{/each}}
</ul>
{{/inline}}
{{> (lookup this "parent")}}